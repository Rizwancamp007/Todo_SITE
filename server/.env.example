# Backend Environment Template — copy to .env and fill values

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string (get from atlas.mongodb.com)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.XXXXX.mongodb.net/todo-app?retryWrites=true&w=majority

# Your Vercel frontend URL (set this after Vercel deploy, e.g. https://todo-site.vercel.app)
CLIENT_URL=https://YOUR-APP.vercel.app
